let mapleader = "  "

syntax on

filetype plugin indent on

colorscheme industry

set autoindent
set clipboard=unnamedplus
set expandtab
set laststatus=2
set mouse=a
set nofoldenable
set nopaste
set shiftwidth=4
set smartindent
set softtabstop=4
set statusline=%f
set tabstop=4
set listchars=tab:>-,space:.,trail:.,eol:$
set nu
set textwidth=100
set laststatus=2
set statusline=%f\ %m%=Line:\ %l,\ Column:\ %c\ [%y]

